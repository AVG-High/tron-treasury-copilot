# Optional AI extraction. Set BOTH values to enable AI. Keep blank for honest manual mode.
# Choose a model available to your OpenAI project that supports Responses structured outputs.
# These values remain on the API server; never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional public read-only TRON gateway key (server only).
TRONGRID_API_KEY=

# Local development defaults. Vite UI uses 4177, this API uses 4187.
HOST=127.0.0.1
PORT=4187
# Do not set NODE_ENV here: Vite selects development/build mode and npm start sets production.

# Set an exact HTTPS origin for a future public deployment, together with HOST=0.0.0.0.
# No trailing path, username, query or fragment. Configure authentication/rate budgets
# at your ingress before exposing a paid AI endpoint to an untrusted audience.
PUBLIC_ORIGIN=

# This project has no private-key, mnemonic, seed, server signer or broadcast setting.
